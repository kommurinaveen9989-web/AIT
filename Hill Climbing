      "source": [
        "from collections import deque\n",
        "\n",
        "s, t, d = (0, 0), (1, 2), [(-1, 0), (1, 0), (0, -1), (0, 1)]\n",
        "\n",
        "# 1. First 10 Paths (DFS)\n",
        "P = []\n",
        "def dfs(r, c, v, p):\n",
        "    if len(P) < 10:\n",
        "        if (r, c) == t: P.append(list(p))\n",
        "        else:\n",
        "            for dr, dc in d:\n",
        "                nr, nc = r + dr, c + dc\n",
        "                if 0 <= nr < 3 and 0 <= nc < 3 and (nr, nc) not in v:\n",
        "                    v.add((nr, nc)); p.append((nr, nc))\n",
        "                    dfs(nr, nc, v, p)\n",
        "                    p.pop(); v.remove((nr, nc))\n",
        "dfs(s[0], s[1], {s}, [s])\n",
        "\n",
        "# 2. Shortest Path (BFS)\n",
        "Q, V, sh = deque([[s]]), {s}, []\n",
        "while Q and not sh:\n",
        "    p = Q.popleft()\n",
        "    if p[-1] == t: sh = p\n",
        "    else:\n",
        "        for dr, dc in d:\n",
        "            nr, nc = p[-1][0] + dr, p[-1][1] + dc\n",
        "            if 0 <= nr < 3 and 0 <= nc < 3 and (nr, nc) not in V:\n",
        "                V.add((nr, nc)); Q.append(p + [(nr, nc)])\n",
        "\n",
        "# Print Results\n",
        "print(\"=== FIRST 10 PATHS ===\")\n",
        "print(\"\\n\".join(f\"{i}: \" + \" -> \".join(map(str, p)) for i, p in enumerate(P, 1)))\n",
        "print(f\"\\n=== SHORTEST PATH ({len(sh)-1} steps) ===\")\n",
        "print(\" -> \".join(map(str, sh)))"
      ]
    }
